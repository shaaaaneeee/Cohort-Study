# Cohort Studio API settings. Copy to .env for local runs outside Docker;
# in Northflank set these as environment variables / secrets instead.
# Every variable is described in docs/deployment.md.

# --- server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# json (for log collectors) or text (easier to read locally)
LOG_FORMAT=text
# Browser origins allowed to call the API, comma separated: the frontend's URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional shared key; when set, /api requests must send it as X-API-Key.
API_KEY=

# --- database: either DATABASE_URL ...
DATABASE_URL=
# ... or the separate settings. Use the app's read-only role (docs/db-setup.md).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cohort
DB_USER=cohort_app
DB_PASSWORD=
DB_SSLMODE=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=120000
# Leave empty to use config/mapping.yaml.
MAPPING_PATH=

# --- study assistant (LLM)
# Leave LLM_API_KEY empty to run the scripted demo instead of a real model.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_SCRIPT=

# --- seeding (python -m app.seed); an owner role, never the app's role
SEED_DATABASE_URL=

# --- tests (pytest); a role that may create schemas
TEST_DATABASE_URL=
