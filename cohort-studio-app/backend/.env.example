# Cohort Studio MCP server settings. In a Databricks App these come from
# app.yaml; copy this file to .env only to run the server outside an App.

# --- server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# json (for log collectors) or text (easier to read locally)
LOG_FORMAT=text
# Browser origins allowed to call /mcp, comma separated: the workspace URL,
# for Genie Code.
CORS_ORIGINS=
# Optional. When set, every /mcp request must send "Authorization: Bearer
# <MCP_TOKEN>". Leave empty in a Databricks App: the platform signs callers in.
MCP_TOKEN=

# --- data
# Empty for config/mapping.yaml (tables under workspace.cohort).
MAPPING_PATH=
# The SQL warehouse to read through. Outside an App, also set the usual
# Databricks SDK variables (DATABRICKS_HOST and DATABRICKS_TOKEN, or a profile)
# in your shell, never in a committed file.
DATABRICKS_WAREHOUSE_ID=
DB_STATEMENT_TIMEOUT_MS=120000
