# Cohort Studio MCP server settings. In a Databricks App these come from
# app.yaml; copy this file to .env only for a local run.

# --- server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# json (for log collectors) or text (easier to read locally)
LOG_FORMAT=text
# Browser origins allowed to call /mcp, comma separated: the workspace URL,
# for Genie Code.
CORS_ORIGINS=
# Optional. When set, every /mcp request must send "Authorization: Bearer
# <MCP_TOKEN>". Leave empty in a Databricks App: the platform signs callers in.
MCP_TOKEN=

# --- data
# config/mapping.databricks.yaml reads a Databricks SQL warehouse; leave empty
# for config/mapping.yaml (PostgreSQL, local runs and tests).
MAPPING_PATH=
DATABRICKS_WAREHOUSE_ID=

# PostgreSQL (local only): either DATABASE_URL or the DB_* settings.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cohort
DB_USER=cohort_app
DB_PASSWORD=
DB_SSLMODE=
DB_STATEMENT_TIMEOUT_MS=120000

# --- local test data (python -m app.seed) and tests (pytest)
SEED_DATABASE_URL=
TEST_DATABASE_URL=
