# Settings for docker-compose.yml (local development only). Copy to .env.
# Every value is optional: without them compose uses local-only defaults and
# the assistant plays its scripted demo.

# Passwords for the mock database's owner and the app's read-only role.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Set to use a real model for the study assistant.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Optional shared key between frontend and backend (see docs/deployment.md).
API_KEY=
